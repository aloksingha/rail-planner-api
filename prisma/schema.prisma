generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  name         String?
  mobile       String?
  role         String          @default("CUSTOMER")
  region       String?         // Applicable for SALES_MANAGER
  status       String          @default("ACTIVE") // ACTIVE, BLOCKED, RESTRICTED
  createdAt    DateTime        @default(now())
  
  createdByUserId String?
  createdBy       User?           @relation("UserCreator", fields: [createdByUserId], references: [id])
  createdUsers    User[]          @relation("UserCreator")

  bookings       Booking[]
  paymentRecords PaymentRecord[]
  refundRecords  RefundRecord[]
  
  auditLogsTarget    AuditLog[] @relation("TargetUser")
  auditLogsPerformed AuditLog[] @relation("PerformedBy")
  priceRequests      PriceRequest[]
  walletBalance       Float           @default(0)
  walletTransactions  WalletTransaction[]
  withdrawalRequests  WithdrawalRequest[]

  @@index([role])
  @@index([createdByUserId])
}

model Event {
  id          String   @id @default(uuid())
  name        String
  description String
  date        DateTime
  
  bookings Booking[]
}

model Booking {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  paymentId String?
  ticketUrl String?
  status    String   @default("CONFIRMED")
  class     String?  // 'AC' (includes 2A, 3A, CC) or 'SLEEPER' (includes SL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  refundRecords RefundRecord[]

  @@index([createdAt])
  @@index([class])
  @@index([userId])
  @@index([class, createdAt])
  @@index([userId, createdAt])
  @@index([paymentId])
}

model PaymentRecord {
  id        String   @id @default(uuid())
  orderId   String
  paymentId String   @unique
  amount    Float
  status    String   @default("CAPTURED")
  userId    String
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model RefundRecord {
  id                    String       @id @default(uuid())
  paymentId             String
  amount                Float
  region                String       @default("Global")
  status                String       @default("AUTOMATED_PENDING")
  reason                String?
  originalFailureReason String?
  manualCreditDueDate   DateTime?
  attempts              Int          @default(0)
  razorpayRefundId      String?
  userId                String
  bookingId             String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  
  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([status])
  @@index([userId])
  @@index([manualCreditDueDate])
  @@index([paymentId])
}

model AuditLog {
  id                String   @id @default(uuid())
  action            String
  targetUserId      String?
  performedByUserId String
  details           String?
  timestamp         DateTime @default(now())
  
  targetUser      User? @relation("TargetUser", fields: [targetUserId], references: [id])
  performedByUser User  @relation("PerformedBy", fields: [performedByUserId], references: [id])

  @@index([action])
  @@index([timestamp])
  @@index([targetUserId])
  @@index([performedByUserId])
}

model PriceRequest {
  id             String   @id @default(uuid())
  userId         String
  trainName      String
  trainNumber    String
  source         String
  destination    String
  class          String
  suggestedPrice Float?
  status         String   @default("PENDING") // PENDING, UPDATED, COMPLETED
  adminComment   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([createdAt])
}

model CorridorPricing {
  id                  String   @id @default(uuid())
  name                String   @unique
  originStations      String   // JSON array of station codes e.g. '["GHY", "KYQ"]'
  destinationStations String   // JSON array of station codes
  markupSL            Float    @default(0) // Total price for Sleeper
  markup3A            Float    @default(0) // Total price for 3A
  markup2A            Float    @default(0) // Total price for 2A
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("UNREAD") // UNREAD, READ, RESOLVED
  createdAt DateTime @default(now())
}

model Coupon {
  id               String   @id @default(uuid())
  code             String   @unique
  discountType     String   // 'PERCENTAGE' or 'FIXED'
  discountValue    Float
  minBookingAmount Float    @default(0)
  maxDiscount      Float?   // Only relevant for PERCENTAGE
  expiryDate       DateTime?
  isActive         Boolean  @default(true)
  usageLimit       Int?     // Maximum total uses allowed
  usageCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([code])
}

model GlobalSettings {
  id         String   @id @default("singleton")
  email      String   @default("support@ticketspro.in")
  phone      String   @default("1800-123-4567")
  address    String   @default("123 Express Hub, Tech Park Phase 2, Bengaluru, Karnataka 560100")
  whatsapp   String   @default("")
  facebook   String   @default("")
  telegram   String   @default("")
  otaVersion String   @default("")
  updatedAt  DateTime @updatedAt
}

model FailedBooking {
  id           String   @id @default(uuid())
  name         String
  email        String
  mobile       String
  trainName    String?
  trainNumber  String?
  source       String?
  destination  String?
  journeyDate  String?
  class        String?
  reason       String? // e.g. "Payment Cancelled", "Payment Failed"
  status       String   @default("PENDING") // PENDING, FOLLOWED_UP, IGNORED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([mobile])
  @@index([status])
}

model WalletTransaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Float
  type        String   // 'CREDIT', 'DEBIT', 'REFUND'
  description String?
  bookingId   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model WithdrawalRequest {
  id           String   @id @default(uuid())
  userId       String
  amount       Float
  charge       Float    @default(0)
  status       String   @default("PENDING") // PENDING, APPROVED, COMPLETED, REJECTED
  method       String   @default("UPI")     // UPI, BANK
  details      String?                      // e.g. "UPI: xyz@okicici"
  adminComment String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
}

model StationMapping {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  city      String?
  createdAt DateTime @default(now())
}

model StationNearby {
  id          String @id @default(uuid())
  stationCode String
  nearbyCode  String

  @@unique([stationCode, nearbyCode])
  @@index([stationCode])
}

model PricingRule {
  id           String   @id @default(uuid())
  class        String   @unique // SL, 3A, 2A, etc.
  basePrice    Float
  pricePerHour Float
  fixedMarkup  Float
  updatedAt    DateTime @updatedAt
}

model SpecialCharge {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "SUPERFAST"
  pattern   String   // regex or simple string match for train name
  amountSL  Float    @default(0)
  amount3A  Float    @default(0)
  amount2A  Float    @default(0)
  amount2S  Float    @default(0)
}

model Promotion {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  linkUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

